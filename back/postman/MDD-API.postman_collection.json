      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log(\"Script Auth exécuté, code =\", pm.response.code);\r\n\r\nif (pm.response.code === 200 || pm.response.code === 201) {\r\n    const token = pm.response.json().token;\r\n    pm.collectionVariables.set(\"token\", token);\r\n\r\n    pm.test(\"Token reçu et enregistré\", () => {\r\n        pm.expect(token).to.be.a(\"string\").and.not.empty;\r\n    });\r\n}"
            ]
          }
        }
